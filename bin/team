#!/usr/bin/env bash
# team new <proj> | attach <proj> <repo-path> [branch] | assign <proj> <role> "<task>" [--runtime R] [--model M] [--new] | wait <id> [secs] | ls | close <proj> [role] | display start|stop | ui [port]
# Workers = a coding-agent CLI (adapter agents/runtime/<R>.sh, default opencode) in tmux PANES of the window you run claude in (tagged @team=<proj>-<role>).
set -euo pipefail
ROOT=${STUDIO_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}
PROJ=${TEAM_PROJECTS:-$ROOT/projects}
P() { echo "$PROJ/$1"; }
die() { echo "$*" >&2; exit 1; }
fm() { awk -v k="$2" 'NR==1&&$0!="---"{exit} /^---$/{c++;next} c==1 && index($0,k": ")==1{print substr($0,length(k)+3); exit}' "$1" 2>/dev/null; }   # frontmatter value
body() { awk 'NR==1&&$0!="---"{c=2} /^---$/&&c<2{c++;next} c>=2' "$1"; }   # text after frontmatter (whole file if none)
base_of() { local r=$1; while :; do [ -f "$ROOT/agents/$r.md" ] && { echo "$ROOT/agents/$r.md"; return; }; [[ $r == *-* ]] || break; r=${r%-*}; done; echo "$ROOT/agents/_base.md"; }   # dev-fe -> dev.md
pick() { local v=$2; [ -n "$v" ] || v=$(fm "$flex" "$1"); [ -n "$v" ] || v=$(fm "$a" "$1"); echo "${v:-$3}"; }   # flag > flex > base > default
TEAM_DISPLAY=${TEAM_DISPLAY:-:99}; VNC_PORT=${TEAM_VNC_PORT:-5999}; WEB_PORT=${TEAM_WEB_PORT:-6080}
export TEAM_DISPLAY
RUN="$PROJ/.display"   # pidfiles + logs of the shared browser display
up() { [ -f "$RUN/$1.pid" ] && kill -0 "$(cat "$RUN/$1.pid")" 2>/dev/null; }
bg() { local n=$1; shift; up "$n" || { setsid nohup "$@" >"$RUN/$n.log" 2>&1 & echo $! > "$RUN/$n.pid"; }; }
display_start() {   # ponytail: one shared display, browser workers run one at a time; per-worker displays if parallel QA is needed
  mkdir -p "$RUN"
  bg xvfb Xvfb "$TEAM_DISPLAY" -screen 0 1440x900x24 -nolisten tcp; sleep 1
  bg vnc x11vnc -display "$TEAM_DISPLAY" -rfbport "$VNC_PORT" -localhost -nopw -forever -shared -quiet
  bg web websockify --web /usr/share/novnc "127.0.0.1:$WEB_PORT" "127.0.0.1:$VNC_PORT"
  sleep 1
  echo "browser live view: ssh -L $WEB_PORT:localhost:$WEB_PORT <host>  ->  http://localhost:$WEB_PORT/vnc.html" >&2
}
display_stop() { for n in web vnc xvfb; do if up "$n"; then kill "$(cat "$RUN/$n.pid")"; for _ in {1..30}; do up "$n" || break; sleep 0.1; done; fi; rm -f "$RUN/$n.pid"; done; }
browser_busy() {   # task ids of live browser workers without .done
  tmux list-panes -a -F '#{?#{@browser},1,0} #{?#{@dead},1,0} #{@tid}' | awk '$1==1 && $2!=1 {print $3}' |
    while read -r t; do ls "$PROJ"/*/.team/out/"$t".done >/dev/null 2>&1 || echo "$t"; done
}
pane_of() { tmux list-panes -a -F '#{pane_id} #{@team}' | awk -v n="$1" '$2==n{print $1}' | head -1; }
# header: pane border shows "role | status task"; window-local, user's global tmux config untouched
header() { # <pane> <id> <icon> <task text>
  tmux set-option -p -t "$1" @tid "$2"; tmux set-option -p -t "$1" @task "$3 ${4:0:70}"
}
cmd=${1:-}; shift || true
case $cmd in
new)
  d=$(P "$1"); [ -e "$d" ] && { echo "exists: $d" >&2; exit 1; }
  mkdir -p "$d"/{docs,.team/tasks,.team/out,.team/roles}; git -C "$d" init -q
  printf '.team/\n' >> "$d/.git/info/exclude"
  echo "# Idea: $1" > "$d/docs/idea.md"; echo "$d" ;;
attach) # existing repo: isolated git worktree on a new branch, main checkout untouched
  d=$(P "$1"); r=$(readlink -f "$2"); b=${3:-feat/$1}; [ -e "$d" ] && { echo "exists: $d" >&2; exit 1; }
  git -C "$r" worktree add -q -b "$b" "$d"   # ponytail: git repos only; node_modules/.env aren't copied, install in the worktree
  mkdir -p "$d"/docs "$d"/.team/{tasks,out,roles}
  printf '.team/\ndocs/feature*.md\n' >> "$(git -C "$d" rev-parse --git-path info/exclude)"  # keep studio files out of their diff
  echo "$d" ;;
assign)
  proj=$1 role=$2 task=$3; shift 3; d=$(P "$proj"); ropt= mopt= newp=
  while [ $# -gt 0 ]; do case $1 in --runtime) ropt=$2; shift 2 ;; --model) mopt=$2; shift 2 ;; --new) newp=1; shift ;; *) die "unknown flag $1" ;; esac; done
  [[ $role =~ ^[a-z][a-z0-9-]*$ ]] || die "role must be lowercase-with-dashes (e.g. dev-fe)"
  [ -d "$d" ] || die "no project: $d"
  id="$proj-$role-$(date +%H%M%S)"
  n=2; while [ -e "$d/.team/tasks/$id.md" ]; do id="${id%-[0-9]}-$n"; n=$((n+1)); done   # same-second assigns must not overwrite each other's task
  a=$(base_of "$role"); flex="$d/.team/roles/$role.md"
  runtime=$(pick runtime "$ropt" opencode)
  model=$(pick model "$mopt" fidt/qwen3.8-flash)
  browser=$(pick browser "" none)
  case $model in *kCode*) dt=1800 ;; *) dt=900 ;; esac   # kCode upstream can queue 100-200s per request
  timeout=$(pick timeout "" $dt)
  rt="$ROOT/agents/runtime/$runtime.sh"; [ -f "$rt" ] || die "unknown runtime: $runtime (see agents/runtime/)"
  msg="Read .team/tasks/$id.md and do it exactly."
  source "$rt"; rt_preflight
  if [ "$browser" != none ]; then
    busy=$(browser_busy); [ -z "$busy" ] || die "browser display busy with: $busy (one browser worker at a time; team wait/close it first)"
    display_start
  fi
  { body "$a"; [ -f "$flex" ] && { printf '\n## Project notes (from lead)\n'; body "$flex"; }; } > "$d/.team/role-$role.md"
  tag="$proj-$role"; pane=$(pane_of "$tag")
  [ -n "$newp" ] && { n=2; while [ -n "$(pane_of "$tag-$n")" ]; do n=$((n+1)); done; tag="$tag-$n"; pane=; }   # --new: extra parallel worker
  if [ -n "$pane" ]; then   # exited (or finished one-shot) worker: respawn fresh, never send keys to it; busy one-shot: refuse
    if [ "$(tmux show-option -pqv -t "$pane" @dead)" = 1 ]; then tmux kill-pane -t "$pane"; pane=
    elif [ -n "${RT_ONESHOT:-}" ] && [ "$(tmux show-option -pqv -t "$pane" @runtime)" = "$runtime" ]; then
      otid=$(tmux show-option -pqv -t "$pane" @tid)
      [ -e "$d/.team/out/$otid.done" ] || die "worker $tag is still busy with $otid; team wait it, or use --new"
      tmux kill-pane -t "$pane"; pane=
    fi
  fi
  [ -z "$pane" ] || { pr=$(tmux show-option -pqv -t "$pane" @runtime); pm=$(tmux show-option -pqv -t "$pane" @model)
    [ "$pr/$pm" = "$runtime/$model" ] || die "worker $tag runs $pr/$pm; use --new or 'team close $proj $role' to switch"; }
  cat > "$d/.team/tasks/$id.md" <<T
# Task $id (role: $role) (worker: ${tag#$proj-})
You are acting as: $role.
$task

## When done (in this order)
1. Write your result summary to .team/out/$id.md
2. Then run: touch .team/out/$id.done
T
  title=$(head -1 <<<"$task")
  if [ -n "$pane" ]; then   # reuse live worker: follow-up message
    tmux send-keys -t "$pane" -l "$msg"; sleep 0.3; tmux send-keys -t "$pane" Enter
    header "$pane" "$id" "⏳" "$title"; echo "$pane" > "$d/.team/out/$id.pane"
    tmux set-option -p -t "$pane" @timeout "$timeout"
    [ "$browser" != none ] && tmux set-option -p -t "$pane" @browser 1
  else                      # first message goes in as the agent's argument: no startup race
    kvs=$(rt_env) || exit 1   # not via process substitution: adapter failures must abort
    envs=(); while IFS= read -r kv; do [ -n "$kv" ] && envs+=(-e "$kv"); done <<<"$kvs"
    # bash -c: the pane command is bash syntax; never run it through the user's tmux default-shell (e.g. fish)
    pane=$(tmux split-window -d -P -F '#{pane_id}' -t "${TMUX_PANE:?run inside tmux}" -c "$d" "${envs[@]}" bash -c \
      "$(rt_cmd); tmux set-option -p -t \"\$TMUX_PANE\" @dead 1; read -p 'worker exited, enter to close'")
    tmux set-option -p -t "$pane" @team "$tag"; header "$pane" "$id" "⏳" "$title"; echo "$pane" > "$d/.team/out/$id.pane"
    tmux set-option -p -t "$pane" @timeout "$timeout"; tmux set-option -p -t "$pane" @runtime "$runtime"; tmux set-option -p -t "$pane" @model "$model"
    [ "$browser" != none ] && tmux set-option -p -t "$pane" @browser 1
    tmux set-option -w -t "$pane" pane-border-status top
    tmux set-option -w -t "$pane" pane-border-format \
      ' #{?#{@team},#[bold]#{@team}#[nobold] │ #{@task},claude (lead)} '
    tmux select-layout -t "$pane" main-vertical   # claude stays big on the left, workers stacked right
  fi
  echo "$id" ;;
wait)  # done (0) | timeout (1) | dead (2): worker exited or its pane is gone without .done
  pn() { local f; f=$(ls "$PROJ"/*/.team/out/"$1".pane 2>/dev/null | head -1 || true)   # pane recorded at assign (a reused pane's @tid moves on)
    if [ -n "$f" ]; then local q; q=$(cat "$f"); tmux display -p -t "$q" '#{pane_id}' 2>/dev/null || true
    else tmux list-panes -a -F '#{pane_id} #{@tid}' | awk -v i="$1" '$2==i{print $1}' | head -1; fi; }
  p=$(pn "$1"); lim=${2:-}
  [ -n "$lim" ] || { [ -n "$p" ] && lim=$(tmux show-option -pqv -t "$p" @timeout); }   # inside || so set -e ignores an empty p
  lim=${lim:-900}
  for ((i=0; i<lim; i++)); do
    f=$(ls "$PROJ"/*/.team/out/"$1".done 2>/dev/null | head -1 || true)
    if [ -n "$f" ]; then
      p=$(pn "$1"); [ -n "$p" ] && { t=$(tmux show-option -pqv -t "$p" @task); header "$p" "$1" "✓" "${t#* }"; }
      echo done; exit 0
    fi
    p=$(pn "$1")
    if [ -z "$p" ] || [ "$(tmux show-option -pqv -t "$p" @dead)" = 1 ]; then echo dead; exit 2; fi
    sleep 1
  done; echo timeout; exit 1 ;;
display) case ${1:-} in start) display_start ;; stop) display_stop ;; *) die "team display start|stop" ;; esac ;;
ui)    "$ROOT/ui/build.sh" || { [ -f "$ROOT/ui/dist/index.html" ] && echo "dashboard rebuild failed: serving the previous build" >&2 || die "dashboard not built (see above)"; }
       exec python3 "$ROOT/ui/serve.py" "${1:-7777}" ;;   # read-only dashboard: workers, tasks, docs, diffs, terminals
ls)    tmux list-panes -a -F '#{pane_id} #{@team}' | awk 'NF==2' || true ;;
close) tmux list-panes -a -F '#{pane_id} #{@team}' | awk -v p="$1" -v r="${2:-}" 'r=="" && index($2,p"-")==1 {print $1} r!="" && ($2==p"-"r || $2 ~ ("^"p"-"r"-[0-9]+$")) {print $1}' | xargs -r -n1 tmux kill-pane -t ;;
*) sed -n '2p' "$0"; exit 1 ;;
esac
