#!/usr/bin/env bash
# team new <proj> | attach <proj> <repo-path> [branch] | assign <proj> <role> "<task>" [--runtime R] [--model M] [--new] | wait <id> [secs] | ls | close <proj> [role|--box] | run <proj> [<name> "<cmd>"] | stop <proj> <name> | exec <proj> "<cmd>" | egress <proj> | url <proj> | https <proj> <port> | display start|stop | ui [port]
# Workers = a coding-agent CLI (adapter agents/runtime/<R>.sh, default opencode) in tmux PANES of the window you run claude in (tagged @team=<proj>-<role>).
set -euo pipefail
ROOT=${STUDIO_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}
PROJ=${TEAM_PROJECTS:-$ROOT/projects}
P() { echo "$PROJ/$1"; }
die() { echo "$*" >&2; exit 1; }
fm() { awk -v k="$2" 'NR==1&&$0!="---"{exit} /^---$/{c++;next} c==1 && index($0,k": ")==1{print substr($0,length(k)+3); exit}' "$1" 2>/dev/null; }   # frontmatter value
body() { awk 'NR==1&&$0!="---"{c=2} /^---$/&&c<2{c++;next} c>=2' "$1"; }   # text after frontmatter (whole file if none)
base_of() { local r=$1; while :; do [ -f "$ROOT/agents/$r.md" ] && { echo "$ROOT/agents/$r.md"; return; }; [[ $r == *-* ]] || break; r=${r%-*}; done; echo "$ROOT/agents/_base.md"; }   # dev-fe -> dev.md
pick() { local v=$2; [ -n "$v" ] || v=$(fm "$flex" "$1"); [ -n "$v" ] || v=$(fm "$a" "$1"); echo "${v:-$3}"; }   # flag > flex > base > default
SANDBOX=${TEAM_SANDBOX:-box}; case $SANDBOX in box|none) ;; *) die "TEAM_SANDBOX must be box or none" ;; esac
source "$ROOT/bin/box.sh"   # one Docker box per project: network, filesystem allowlist, egress firewall
TEAM_DISPLAY=${TEAM_DISPLAY:-:99}; VNC_PORT=${TEAM_VNC_PORT:-5999}; WEB_PORT=${TEAM_WEB_PORT:-6080}
export TEAM_DISPLAY
RUN="$PROJ/.display"   # pidfiles + logs of the shared browser display
up() { [ -f "$RUN/$1.pid" ] && kill -0 "$(cat "$RUN/$1.pid")" 2>/dev/null; }
bg() { local n=$1; shift; up "$n" || { setsid nohup "$@" >"$RUN/$n.log" 2>&1 & echo $! > "$RUN/$n.pid"; }; }
display_start() {   # ponytail: one shared display, browser workers run one at a time; per-worker displays if parallel QA is needed
  mkdir -p "$RUN"
  bg xvfb Xvfb "$TEAM_DISPLAY" -screen 0 1440x900x24 -nolisten tcp; sleep 1
  bg vnc x11vnc -display "$TEAM_DISPLAY" -rfbport "$VNC_PORT" -localhost -nopw -forever -shared -quiet
  bg web websockify --web /usr/share/novnc "127.0.0.1:$WEB_PORT" "127.0.0.1:$VNC_PORT"
  sleep 1
  echo "browser live view: ssh -L $WEB_PORT:localhost:$WEB_PORT <host>  ->  http://localhost:$WEB_PORT/vnc.html" >&2
}
display_stop() { for n in web vnc xvfb; do if up "$n"; then kill "$(cat "$RUN/$n.pid")"; for _ in {1..30}; do up "$n" || break; sleep 0.1; done; fi; rm -f "$RUN/$n.pid"; done; }
browser_busy() {   # task ids of live browser workers without .done
  tmux list-panes -a -F '#{?#{@browser},1,0} #{?#{@dead},1,0} #{@tid}' | awk '$1==1 && $2!=1 {print $3}' |
    while read -r t; do x=$(task_dir "$t"); [ -n "$x" ] && [ -e "$x/.team/out/$t.done" ] || echo "$t"; done
}
task_dir() { local f; f=$(ls "$PROJ"/*/.team/tasks/"$1".md 2>/dev/null | head -1) || true; [ -z "$f" ] || echo "${f%/.team/tasks/*}"; }   # project of a task id, from the host-written task file (out/ is box-writable)
put() { rm -f "$2"; (set -C; echo "$1" > "$2"); }   # write into a box-writable dir: replace a planted link, never follow it
pane_of() { tmux list-panes -a -F '#{pane_id} #{@team}' | awk -v n="$1" '$2==n{print $1}' | head -1; }
# header: pane border shows "role | status task"; window-local, user's global tmux config untouched
header() { # <pane> <id> <icon> <task text>
  tmux set-option -p -t "$1" @tid "$2"; tmux set-option -p -t "$1" @task "$3 ${4:0:70}"
}
env_copy() {   # <main checkout> <worktree>: gitignored .env* files, same relative paths (the app in the box must match main)
  git -C "$1" ls-files -z -o -i --exclude-standard -- ':(glob)**/.env*' |
    while IFS= read -r -d '' f; do
      [[ $f =~ (^|/)(node_modules|\.garden|\.worktrees)/ ]] && continue
      mkdir -p "$2/$(dirname "$f")"; cp -p "$1/$f" "$2/$f"; echo "copied $f" >&2
    done
}
cmd=${1:-}; shift || true
case $cmd in
new)
  d=$(P "$1"); [ -e "$d" ] && { echo "exists: $d" >&2; exit 1; }
  mkdir -p "$d"/{docs,.team/tasks,.team/out,.team/roles}; git -C "$d" init -q
  printf '.team/\n' >> "$d/.git/info/exclude"
  echo "# Idea: $1" > "$d/docs/idea.md"; echo "$d" ;;
attach) # existing repo: isolated git worktree on a new branch, main checkout untouched
  d=$(P "$1"); r=$(readlink -f "$2"); b=${3:-feat/$1}; [ -e "$d" ] && { echo "exists: $d" >&2; exit 1; }
  git -C "$r" worktree add -q -b "$b" "$d"   # ponytail: git repos only; deps aren't copied, install in the box (team exec)
  mkdir -p "$d"/docs "$d"/.team/{tasks,out,roles}
  printf '.team/\ndocs/feature*.md\n' >> "$(git -C "$d" rev-parse --git-path info/exclude)"  # keep studio files out of their diff
  env_copy "$r" "$d"; echo "$d" ;;
assign)
  proj=$1 role=$2 task=$3; shift 3; d=$(P "$proj"); ropt= mopt= newp=
  while [ $# -gt 0 ]; do case $1 in --runtime) ropt=$2; shift 2 ;; --model) mopt=$2; shift 2 ;; --new) newp=1; shift ;; *) die "unknown flag $1" ;; esac; done
  [[ $role =~ ^[a-z][a-z0-9-]*$ ]] || die "role must be lowercase-with-dashes (e.g. dev-fe)"
  [ -d "$d" ] || die "no project: $d"
  d=$(readlink -f "$d")   # one resolved path everywhere: adapter paths must match the box mounts
  id="$proj-$role-$(date +%H%M%S)"
  n=2; while [ -e "$d/.team/tasks/$id.md" ]; do id="${id%-[0-9]}-$n"; n=$((n+1)); done   # same-second assigns must not overwrite each other's task
  a=$(base_of "$role"); flex="$d/.team/roles/$role.md"
  runtime=$(pick runtime "$ropt" opencode)
  model=$(pick model "$mopt" fidt/qwen3.8-flash)
  browser=$(pick browser "" none)
  case $model in *kCode*) dt=1800 ;; *) dt=900 ;; esac   # kCode upstream can queue 100-200s per request
  timeout=$(pick timeout "" $dt)
  # flex files are data: these values reach source, tmux and bash arithmetic
  [[ $runtime =~ ^[a-z0-9-]+$ ]] || die "bad runtime: $runtime"; [[ $model =~ ^[A-Za-z0-9._/:-]+$ ]] || die "bad model: $model"
  [[ $timeout =~ ^[0-9]+$ ]] || die "bad timeout: $timeout"
  rt="$ROOT/agents/runtime/$runtime.sh"; [ -f "$rt" ] || die "unknown runtime: $runtime (see agents/runtime/)"
  msg="Read .team/tasks/$id.md and do it exactly."
  source "$rt"; rt_preflight
  if [ "$browser" != none ]; then
    busy=$(browser_busy); [ -z "$busy" ] || die "browser display busy with: $busy (one browser worker at a time; team wait/close it first)"
    display_start
  fi
  [ "$SANDBOX" = none ] || box_up "$proj"   # fail-closed: no box, no worker (before any task file or pane exists)
  rm -f "$d/.team/role-$role.md"   # never write through a planted link
  { body "$a"; [ -f "$flex" ] && { printf '\n## Project notes (from lead)\n'; body "$flex"; }; } > "$d/.team/role-$role.md"
  tag="$proj-$role"; pane=$(pane_of "$tag")
  [ -n "$newp" ] && { n=2; while [ -n "$(pane_of "$tag-$n")" ]; do n=$((n+1)); done; tag="$tag-$n"; pane=; }   # --new: extra parallel worker
  if [ -n "$pane" ]; then   # exited (or finished one-shot) worker: respawn fresh, never send keys to it; busy one-shot: refuse
    if [ "$(tmux show-option -pqv -t "$pane" @dead)" = 1 ]; then tmux kill-pane -t "$pane"; pane=
    elif [ -n "${RT_ONESHOT:-}" ] && [ "$(tmux show-option -pqv -t "$pane" @runtime)" = "$runtime" ]; then
      otid=$(tmux show-option -pqv -t "$pane" @tid)
      [ -e "$d/.team/out/$otid.done" ] || die "worker $tag is still busy with $otid; team wait it, or use --new"
      tmux kill-pane -t "$pane"; pane=
    fi
  fi
  [ -z "$pane" ] || { pr=$(tmux show-option -pqv -t "$pane" @runtime); pm=$(tmux show-option -pqv -t "$pane" @model); ps=$(tmux show-option -pqv -t "$pane" @sandbox)
    [ "$pr/$pm/$ps" = "$runtime/$model/$SANDBOX" ] || die "worker $tag runs $pr/$pm (sandbox: ${ps:-?}); use --new or 'team close $proj $role' to switch"; }   # a host pane must never serve box mode (or vice versa)
  cat > "$d/.team/tasks/$id.md" <<T
# Task $id (role: $role) (worker: ${tag#$proj-})
You are acting as: $role.
$task

## Environment
You run inside this project's private box with its own network: use the framework's default ports (5173, 3000, ...) and bind 0.0.0.0. Do not start long-running servers yourself; the lead runs the app (logs in .team/logs/). Need a restart, a config change or a new internet domain? Write the request in your result file. Never kill a process you did not start.

## When done (in this order)
1. Write your result summary to .team/out/$id.md
2. Then run: touch .team/out/$id.done
T
  title=$(head -1 <<<"$task")
  if [ -n "$pane" ]; then   # reuse live worker: follow-up message
    tmux send-keys -t "$pane" -l "$msg"; sleep 0.3; tmux send-keys -t "$pane" Enter
    header "$pane" "$id" "⏳" "$title"; put "$pane" "$d/.team/out/$id.pane"
    tmux set-option -p -t "$pane" @timeout "$timeout"
    [ "$browser" != none ] && tmux set-option -p -t "$pane" @browser 1
  else                      # first message goes in as the agent's argument: no startup race
    kvs=$(rt_env) || exit 1   # not via process substitution: adapter failures must abort
    [ "$SANDBOX" = none ] || kvs=$(box_env <<<"$kvs")
    envs=(); names=(); while IFS= read -r kv; do [ -n "$kv" ] && { envs+=(-e "$kv"); names+=("${kv%%=*}"); }; done <<<"$kvs"
    c=$(rt_cmd); [ "$SANDBOX" = none ] || c=$(box_cmd "$proj" "$d" "$c" "${names[@]}")   # worker runs in the box; env values stay in the pane env
    # bash -c: the pane command is bash syntax; never run it through the user's tmux default-shell (e.g. fish)
    pane=$(tmux split-window -d -P -F '#{pane_id}' -t "${TMUX_PANE:?run inside tmux}" -c "$d" "${envs[@]}" bash -c \
      "$c; tmux set-option -p -t \"\$TMUX_PANE\" @dead 1; read -p 'worker exited, enter to close'")
    tmux set-option -p -t "$pane" @team "$tag"; header "$pane" "$id" "⏳" "$title"; put "$pane" "$d/.team/out/$id.pane"
    tmux set-option -p -t "$pane" @timeout "$timeout"; tmux set-option -p -t "$pane" @runtime "$runtime"; tmux set-option -p -t "$pane" @model "$model"; tmux set-option -p -t "$pane" @sandbox "$SANDBOX"
    [ "$browser" != none ] && tmux set-option -p -t "$pane" @browser 1
    tmux set-option -w -t "$pane" pane-border-status top
    tmux set-option -w -t "$pane" pane-border-format \
      ' #{?#{@team},#[bold]#{@team}#[nobold] │ #{@task},claude (lead)} '
    tmux select-layout -t "$pane" main-vertical   # claude stays big on the left, workers stacked right
  fi
  echo "$id" ;;
wait)  # done (0) | timeout (1) | dead (2): worker exited or its pane is gone without .done | idle (3): pane unchanged TEAM_IDLE s, no .done
  td=$(task_dir "$1")   # only this task's project: another box can plant <id>.done/.pane in its own out/
  pn() { local f=$td/.team/out/$1.pane   # pane recorded at assign (a reused pane's @tid moves on)
    if [ -n "$td" ] && [ -f "$f" ]; then local q; q=$(cat "$f"); tmux display -p -t "$q" '#{pane_id}' 2>/dev/null || true
    else tmux list-panes -a -F '#{pane_id} #{@tid}' | awk -v i="$1" '$2==i{print $1}' | head -1; fi; }
  p=$(pn "$1"); lim=${2:-}
  [ -n "$lim" ] || { [ -n "$p" ] && lim=$(tmux show-option -pqv -t "$p" @timeout); }   # inside || so set -e ignores an empty p
  lim=${lim:-900}; [[ $lim =~ ^[0-9]+$ ]] || die "bad wait limit: $lim"   # goes into bash arithmetic
  idle=${TEAM_IDLE:-300}; [[ $idle =~ ^[0-9]+$ ]] || die "bad TEAM_IDLE: $idle"; last= since=0 st=$((idle < 15 ? 1 : 15))   # pane hash every st seconds
  for ((i=0; i<lim; i++)); do
    if [ -n "$td" ] && [ -e "$td/.team/out/$1.done" ]; then
      p=$(pn "$1"); [ -n "$p" ] && { t=$(tmux show-option -pqv -t "$p" @task); header "$p" "$1" "✓" "${t#* }"; }
      echo done; exit 0
    fi
    p=$(pn "$1")
    if [ -z "$p" ] || [ "$(tmux show-option -pqv -t "$p" @dead)" = 1 ]; then echo dead; exit 2; fi
    if ((i % st == 0)); then   # a worker that stopped without touching .done sits idle until the timeout: say so early
      s=$(tmux capture-pane -p -t "$p" | md5sum); [ "$s" = "$last" ] || { last=$s; since=$i; }
      ((i - since >= idle)) && { echo idle; exit 3; }
    fi
    sleep 1
  done; echo timeout; exit 1 ;;
display) case ${1:-} in start) display_start ;; stop) display_stop ;; *) die "team display start|stop" ;; esac ;;
run)   p=${1:?team run <proj> [<name> \"<cmd>\"]}; d=$(readlink -f "$(P "$p")"); [ -d "$d" ] || die "no project: $d"
       [ "$SANDBOX" = box ] || die "team run needs the box (TEAM_SANDBOX=none)"
       if [ $# -eq 1 ]; then box_ps "$p" "$d"; exit 0; fi
       [ $# -eq 3 ] || die "team run <proj> [<name> \"<cmd>\"]"
       [[ $2 =~ ^[a-z][a-z0-9-]*$ ]] || die "name must be lowercase-with-dashes (e.g. web, api)"
       box_up "$p"; mkdir -p "$d/.team/logs" "$d/.team/run"
       box_ps "$p" "$d" | grep -qx "$2 running" && die "$2 already running (team stop $p $2 first)"
       # setsid: own process group, so stop takes the dev server's children too; apps are firewalled like workers
       h=$(box_ts_name "$p"); h=${h%%.*}; t0=$(date +%s)
       # Vite rejects unknown Host headers: allow the tailnet name the user opens (http://<name>:<port>); Vite takes one host here
       $DOCKER exec -d -u "$BOX_UID:$BOX_GID" -w "$d" -e "__VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=${h:-$p}" "$(bx "$p")" setsid bash -c 'echo $$ > "$1"; exec bash -c "$2" > "$3" 2>&1' \
         _ "$d/.team/run/$2.pid" "$3" "$d/.team/logs/$2.log"
       # docker exec -d returns before the app writes its pid file: wait for it (max ~3s), then check it is still alive
       sleep 0.3; for _ in {1..10}; do [ "$(stat -c %Y "$d/.team/run/$2.pid" 2>/dev/null || echo 0)" -ge "$t0" ] && break; sleep 0.3; done
       box_ps "$p" "$d" | grep -qx "$2 running" || die "failed to start $2 (see .team/logs/$2.log)"
       h=$(box_ts_name "$p"); echo "started $2 (log: .team/logs/$2.log)${h:+; tailnet host: ${h%%.*}}" ;;
stop)  p=${1:?team stop <proj> <name>}; n=${2:?team stop <proj> <name>}; [[ $n =~ ^[a-z][a-z0-9-]*$ ]] || die "bad app name: $n"; f="$(readlink -f "$(P "$p")")/.team/run/$n.pid"
       [ -e "$f" ] || [ -L "$f" ] || die "not started: $n"; pid=$(box_pid "$f") || die "bad pid file: $f"
       if box_running "$p"; then $DOCKER exec "$(bx "$p")" kill -TERM -- "-$pid" 2>/dev/null || true; fi
       echo "stopped $n" ;;   # pid file stays so team run lists it as stopped; a rerun overwrites it
exec)  p=${1:?team exec <proj> \"<cmd>\"}; d=$(readlink -f "$(P "$p")"); [ -d "$d" ] || die "no project: $d"
       [ "$SANDBOX" = box ] || die "team exec needs the box (TEAM_SANDBOX=none)"
       box_up "$p"; exec $DOCKER exec -u "$BOX_UID:$BOX_GID" -w "$d" "$(bx "$p")" bash -c "${2:?team exec <proj> \"<cmd>\"}" ;;
egress) p=${1:?team egress <proj>}; [ "$SANDBOX" = box ] || die "team egress needs the box (TEAM_SANDBOX=none)"
       box_running "$p" || die "box not running: $p (team assign/run/exec starts it)"
       echo "rejected packets: $(box_fw "$p" --count)"   # before the reload, which resets the counter
       box_fw "$p" || die "egress rules failed"
       echo "allow list: $PROJ/.box/$p.egress (host[:port] per line, default port 443)" ;;
url)   p=${1:?team url <proj>}; box_running "$p" || die "box not running: $p"
       ip=$($DOCKER inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$(bx "$p")"); f=$(box_ts_name "$p")
       [ -n "$f" ] && { echo "tailnet: http://${f%%.*}:<port>"; echo "https:   https://$f   (team https $p <port>)"; }
       echo "box ip:  $ip"; echo "fallback: ssh -L <port>:$ip:<port> <linux-host>" ;;
https) p=${1:?team https <proj> <port>}; port=${2:?team https <proj> <port>}
       $DOCKER inspect "$(bx "$p")-ts" >/dev/null 2>&1 || die "no tailscale sidecar for $p (key file: $TS_KEY)"
       $DOCKER exec "$(bx "$p")-ts" tailscale serve --bg "$port" ;;
ui)    "$ROOT/ui/build.sh" || { [ -f "$ROOT/ui/dist/index.html" ] && echo "dashboard rebuild failed: serving the previous build" >&2 || die "dashboard not built (see above)"; }
       exec python3 "$ROOT/ui/serve.py" "${1:-7777}" ;;   # read-only dashboard: workers, tasks, docs, diffs, terminals
ls)    tmux list-panes -a -F '#{pane_id} #{@team}' | awk 'NF==2' || true ;;
close) p=${1:?team close <proj> [<role>|--box]}; r=${2:-}; [ "$r" = --box ] && r=
       tmux list-panes -a -F '#{pane_id} #{@team}' | awk -v p="$p" -v r="$r" 'r=="" && index($2,p"-")==1 {print $1} r!="" && ($2==p"-"r || $2 ~ ("^"p"-"r"-[0-9]+$")) {print $1}' | xargs -r -n1 tmux kill-pane -t
       # killing the pane only kills the docker exec client: the worker inside the box keeps running and editing files
       [ "$SANDBOX" = none ] || ! box_running "$p" || $DOCKER exec "$(bx "$p")" pkill -f "\.team/tasks/$p-${r:+$r-[0-9]}" || true
       # the box (apps, home volume, tailnet name) goes only when asked: a forgotten role must not wipe it
       if [ "${2:-}" = --box ]; then [ "$SANDBOX" = none ] || box_down "$p"
       elif [ -z "$r" ] && [ "$SANDBOX" != none ] && box_running "$p"; then echo "workers closed; box kept (team close $p --box removes it)" >&2; fi ;;
*) sed -n '2p' "$0"; exit 1 ;;
esac
